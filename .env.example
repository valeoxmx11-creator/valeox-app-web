# Runtime
NODE_ENV=development
APP_ENV=local
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Database (PostgreSQL)
DATABASE_URI=postgresql://postgres:postgres@localhost:5432/valeox

# Payload CMS security
PAYLOAD_SECRET=replace_with_minimum_32_characters_secret
PAYLOAD_PUBLIC_SERVER_URL=http://localhost:3000

# Comma-separated origin allowlists (staging/prod should be explicit)
PAYLOAD_CORS_ORIGINS=http://localhost:3000
PAYLOAD_CSRF_ORIGINS=http://localhost:3000

# WhatsApp redirect target (international format without +)
WHATSAPP_TARGET_NUMBER=15551234567
